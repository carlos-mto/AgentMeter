{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentMeter",
  "version": "0.0.1",
  "identifier": "me.mto.agentmeter",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AgentMeter",
        "width": 644,
        "height": 840,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "visible": false
      },
      {
        "label": "widget",
        "title": "AgentMeter Widget",
        "url": "widget.html",
        "width": 244,
        "height": 164,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
